{
  "name": "dsh-live-pixel",
  "version": "2.1.0-rc.1",
  "description": "Live dithered pixel themes for DSH: a shared WebGL scene engine, a theme picker and readability settings. Ships Borealis, The Well, Neon and The Deep.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maxwelltoo/dsh-live-pixel.git"
  },
  "homepage": "https://github.com/Maxwelltoo/dsh-live-pixel#readme",
  "bugs": {
    "url": "https://github.com/Maxwelltoo/dsh-live-pixel/issues"
  },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "theme", "pixel-art", "webgl"],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "src/*.js",
    "themes/*.js",
    "scripts/*.mjs",
    "tests/*.mjs",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs --check",
    "check": "node scripts/build.mjs --check && node tests/smoke.mjs && node tests/render.real.mjs",
    "test": "node tests/smoke.mjs && node tests/render.real.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
